#!/usr/bin/env python3
"""Build resumable F4CD-v3 candidate profiles for warm donor search."""

from __future__ import annotations

import argparse
import csv
import hashlib
import json
import struct
from collections import defaultdict
from pathlib import Path


CHUNK_SIZE = 1 << 20
ALIGNMENT = 256
DEFAULT_LENGTH = 4096
HEADER = struct.Struct("<4sHHIIQH32s")
ASSIGNMENT = struct.Struct("<HIHB")
PINNED_421 = [
    (407_573_504, 4096),
    (407_581_696, 2048),
    (407_775_744, 2048),
    (407_787_520, 4096),
    (407_793_664, 4096),
    (407_799_808, 4096),
    (407_810_048, 2048),
]


def parse_args() -> argparse.Namespace:
    repo = Path(__file__).resolve().parents[1]
    parser = argparse.ArgumentParser()
    parser.add_argument("stream", type=Path)
    parser.add_argument("output_plan", type=Path)
    parser.add_argument(
        "--candidates",
        type=Path,
        default=repo
        / "research/donor_graph_post_r1_20260727/exact_mesh_all_candidates.csv",
    )
    parser.add_argument("--manifest", type=Path)
    parser.add_argument("--donors-per-region", type=int, default=7)
    parser.add_argument(
        "--fill-recent",
        action="store_true",
        help="fill missing proxy candidates with recent windows (diagnostic only)",
    )
    parser.add_argument("--pin-region-421", action="store_true")
    return parser.parse_args()


def sha256_file(path: Path) -> bytes:
    digest = hashlib.sha256()
    with path.open("rb") as source:
        for block in iter(lambda: source.read(8 << 20), b""):
            digest.update(block)
    return digest.digest()


def valid(offset: int, length: int, recipient_offset: int) -> bool:
    return (
        offset >= 0
        and offset % ALIGNMENT == 0
        and 256 <= length <= 65536
        and length & (length - 1) == 0
        and offset + length <= recipient_offset
    )


def add_candidate(
    profile: list[tuple[int, int, str]],
    seen: set[int],
    offset: int,
    length: int,
    source: str,
    recipient_offset: int,
) -> None:
    if offset not in seen and valid(offset, length, recipient_offset):
        profile.append((offset, length, source))
        seen.add(offset)


def main() -> int:
    args = parse_args()
    if not 1 <= args.donors_per_region <= 32:
        raise SystemExit("--donors-per-region must be between 1 and 32")
    stream_size = args.stream.stat().st_size
    complete_regions = stream_size // CHUNK_SIZE
    if complete_regions > 0xFFFF:
        raise SystemExit("too many complete regions")

    ranked: dict[int, list[tuple[int, int, int]]] = defaultdict(list)
    with args.candidates.open(newline="", encoding="utf-8-sig") as source:
        for row in csv.DictReader(source):
            region = int(row.get("recipient_region") or row["pack_id"])
            donor_offset = int(
                row.get("donor_offset") or row["donor_seed_offset"]
            )
            donor_length = int(row.get("donor_length") or DEFAULT_LENGTH)
            ranked[region].append(
                (int(row["candidate_rank"]), donor_offset, donor_length)
            )
    for rows in ranked.values():
        rows.sort()

    assignments: list[tuple[int, int, int, int]] = []
    manifest_rows: list[dict[str, object]] = []
    for region in range(1, complete_regions):
        recipient_offset = region * CHUNK_SIZE
        profile: list[tuple[int, int, str]] = []
        seen: set[int] = set()
        if args.pin_region_421 and region == 421:
            for offset, length in PINNED_421:
                add_candidate(
                    profile,
                    seen,
                    offset,
                    length,
                    "pinned_421",
                    recipient_offset,
                )
        for _rank, offset, length in ranked.get(region, []):
            if len(profile) >= args.donors_per_region:
                break
            add_candidate(
                profile,
                seen,
                offset,
                length,
                "proxy_ranked",
                recipient_offset,
            )
        fallback_index = 1
        while args.fill_recent and len(profile) < args.donors_per_region:
            offset = recipient_offset - fallback_index * 8192
            fallback_index += 1
            if offset < 0:
                break
            add_candidate(
                profile,
                seen,
                offset,
                DEFAULT_LENGTH,
                "recent_causal",
                recipient_offset,
            )
        if not profile:
            continue
        profile = profile[: args.donors_per_region]
        for order, (offset, length, source) in enumerate(profile):
            assignments.append((region, offset, length, order))
            manifest_rows.append(
                {
                    "recipient_region": region,
                    "recipient_offset": recipient_offset,
                    "order": order,
                    "donor_offset": offset,
                    "donor_length": length,
                    "source": source,
                }
            )

    if len(assignments) > 0xFFFF:
        raise SystemExit("F4CD-v3 supports at most 65535 assignments")
    digest = sha256_file(args.stream)
    args.output_plan.parent.mkdir(parents=True, exist_ok=True)
    with args.output_plan.open("wb") as output:
        output.write(
            HEADER.pack(
                b"F4CD",
                3,
                1,
                CHUNK_SIZE,
                max((length for _, _, length, _ in assignments), default=0),
                stream_size,
                len(assignments),
                digest,
            )
        )
        for assignment in assignments:
            output.write(ASSIGNMENT.pack(*assignment))

    manifest = args.manifest or args.output_plan.with_suffix(".csv")
    manifest.parent.mkdir(parents=True, exist_ok=True)
    with manifest.open("w", newline="", encoding="utf-8") as target:
        writer = csv.DictWriter(
            target,
            fieldnames=[
                "recipient_region",
                "recipient_offset",
                "order",
                "donor_offset",
                "donor_length",
                "source",
            ],
        )
        writer.writeheader()
        writer.writerows(manifest_rows)

    print(
        json.dumps(
            {
                "format": "F4CD-v3",
                "stream": str(args.stream),
                "stream_bytes": stream_size,
                "stream_sha256": digest.hex(),
                "complete_regions": complete_regions,
                "profiled_regions": len(
                    {row["recipient_region"] for row in manifest_rows}
                ),
                "donors_per_region": args.donors_per_region,
                "assignments": len(assignments),
                "external_plan_bytes": args.output_plan.stat().st_size,
                "eventual_archive_plan_bytes_if_all_won": 3
                + 7 * len(assignments),
                "pinned_region_421": args.pin_region_421
                and complete_regions > 421,
                "manifest": str(manifest),
            },
            indent=2,
        )
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
